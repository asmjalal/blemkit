  {
    "id": "sa_cart",
    "type": "Scaffold",
    "properties": {
      "backgroundColor": "4294506744",
      "pageName": "Shopping Cart",
      "appBar": {
        "id": "sa_cart_ab",
        "type": "AppBar",
        "properties": {
          "backgroundColor": "4294967295",
          "elevation": 0.0,
          "title": {
            "id": "sa_cart_ab_title",
            "type": "Text",
            "properties": {
              "text": "My Cart",
              "fontSize": 18.0,
              "color": "4279179050",
              "fontWeight": "bold"
            },
            "children": []
          }
        }
      }
    },
    "children": [
      {
        "id": "sa_cart_col",
        "type": "Column",
        "properties": {
          "mainAxisAlignment": "MainAxisAlignment.start",
          "crossAxisAlignment": "CrossAxisAlignment.stretch"
        },
        "children": [
          {
            "id": "sa_cart_list",
            "type": "ListView",
            "properties": {
              "padding": 16.0,
              "backendQuery": {
                "queryId": "fetch_cart"
              }
            },
            "children": [
              {
                "id": "sa_cart_item",
                "type": "ListTile",
                "properties": {
                  "title": "Cart Product Title",
                  "subtitle": "$0.00",
                  "tileColor": "4294967295",
                  "leading": {
                    "id": "sa_cart_item_img",
                    "type": "Image",
                    "properties": {
                      "src": "https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=400",
                      "width": 50.0,
                      "height": 50.0,
                      "fit": "BoxFit.cover"
                    },
                    "dataBinding": {
                      "src": {
                        "field": "image_url"
                      }
                    },
                    "children": []
                  },
                  "trailing": {
                    "id": "sa_cart_item_del",
                    "type": "IconButton",
                    "properties": {
                      "icon": "Icons.delete_outline",
                      "color": "4294198070",
                      "size": 22.0,
                      "actions": [
                        {
                          "type": "supabase_delete",
                          "tableName": "cart"
                        }
                      ]
                    },
                    "children": []
                  }
                },
                "dataBinding": {
                  "title": {
                    "field": "name"
                  },
                  "subtitle": {
                    "field": "price"
                  }
                },
                "children": []
              }
            ]
          },
          {
            "id": "sa_checkout_card",
            "type": "Card",
            "properties": {
              "color": "4294967295",
              "margin": 16.0,
              "elevation": 2.0,
              "borderRadius": 12.0
            },
            "children": [
              {
                "id": "sa_checkout_pad",
                "type": "Padding",
                "properties": {
                  "padding": 16.0
                },
                "children": [
                  {
                    "id": "sa_checkout_col",
                    "type": "Column",
                    "properties": {
                      "mainAxisAlignment": "MainAxisAlignment.start",
                      "crossAxisAlignment": "CrossAxisAlignment.stretch"
                    },
                    "children": [
                      {
                        "id": "sa_checkout_btn",
                        "type": "ElevatedButton",
                        "properties": {
                          "text": "Place Order",
                          "backgroundColor": "4283385573",
                          "foregroundColor": "4294967295",
                          "height": 50.0,
                          "borderRadius": 8.0,
                          "actions": [
                            {
                              "type": "supabase_insert",
                              "tableName": "orders",
                              "payload": {
                                "total_amount": {
                                  "type": "static",
                                  "value": "299.00"
                                },
                                "status": {
                                  "type": "static",
                                  "value": "Pending"
                                }
                              }
                            },
                            {
                              "type": "navigate",
                              "targetScreenId": "sa_order_success"
                            }
                          ]
                        },
                        "children": []
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
