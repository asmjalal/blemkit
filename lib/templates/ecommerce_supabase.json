                    "dataBinding": {
                      "text": {
                        "field": "price"
                      }
                    },
                    "children": []
                  },
                  {
                    "id": "sa_detail_desc_title",
                    "type": "Text",
                    "properties": {
                      "text": "Description",
                      "fontSize": 14.0,
                      "fontWeight": "bold",
                      "color": "4279179050"
                    },
                    "children": []
                  },
                  {
                    "id": "sa_detail_desc",
                    "type": "Text",
                    "properties": {
                      "text": "Product description will be fetched live from your table.",
                      "fontSize": 13.0,
                      "color": "4284963515"
                    },
                    "dataBinding": {
                      "text": {
                        "field": "description"
                      }
                    },
                    "children": []
                  },
                  {
                    "id": "sa_detail_sp",
                    "type": "SizedBox",
                    "properties": {
                      "height": 40.0
                    },
                    "children": []
                  },
                  {
                    "id": "sa_detail_btn",
                    "type": "ElevatedButton",
                    "properties": {
                      "text": "Add to Cart",
                      "backgroundColor": "4283385573",
                      "foregroundColor": "4294967295",
                      "height": 50.0,
                      "borderRadius": 8.0,
                      "actions": [
                        {
                          "type": "supabase_insert",
                          "tableName": "cart",
                          "payload": {
                            "product_id": {
                              "type": "query_data",
                              "value": "id"
                            },
                            "name": {
                              "type": "query_data",
                              "value": "name"
                            },
                            "price": {
                              "type": "query_data",
                              "value": "price"
                            },
                            "image_url": {
                              "type": "query_data",
                              "value": "image_url"
                            },
                            "quantity": {
                              "type": "static",
                              "value": "1"
                            }
                          }
                        },
                        {
                          "type": "navigate",
                          "targetScreenId": "sa_cart"
                        }
                      ]
                    },
                    "children": []
                  }
                ]
              }
            ]
          }
        ]
