        "properties": {
          "mainAxisAlignment": "MainAxisAlignment.start",
          "crossAxisAlignment": "CrossAxisAlignment.start",
          "backendQuery": {
            "queryId": "fetch_product_details"
          }
        },
        "children": [
          {
            "id": "sa_detail_img",
            "type": "Image",
            "properties": {
              "src": "https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=400",
