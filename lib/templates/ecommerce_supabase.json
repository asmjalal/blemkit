  {
    "id": "__settings__",
    "type": "Scaffold",
    "properties": {
      "pageName": "__settings__",
      "activeConnection": null,
      "queries": [
        {
          "id": "fetch_products",
          "name": "Fetch Products",
          "tableName": "products",
          "queryType": "select",
          "selectColumns": "*",
          "orderBy": "created_at",
          "ascending": false,
          "enableRealtime": false
        },
        {
          "id": "fetch_product_details",
          "name": "Fetch Product Details",
          "tableName": "products",
          "queryType": "select",
          "selectColumns": "*",
          "filters": [
            {
              "column": "id",
              "operator": "eq",
              "value": "idParam"
            }
          ],
          "enableRealtime": false
        },
        {
          "id": "fetch_cart",
          "name": "Fetch Cart",
          "tableName": "cart",
          "queryType": "select",
          "selectColumns": "*",
          "enableRealtime": true
        }
      ]
    },
    "children": []
  }
